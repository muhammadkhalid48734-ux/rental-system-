# ---- Google Sheets (required) ----
# ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Local: path to the service-account key file (keep it out of git).
# Vercel: paste the ENTIRE key file contents (the JSON, one line) as the value instead.
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# ---- Login (required in production, optional locally) ----
# At least 10 characters. Use a long passphrase.
APP_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Signs the session cookie.
SESSION_SECRET=

# ---- AI personalization via Groq (optional; without it the app uses built-in templates) ----
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_RPM=10

# ---- Local only ----
# PORT=3001
